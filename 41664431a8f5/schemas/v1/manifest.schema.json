{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jand-s.github.io/scion/41664431a8f5/schemas/v1/manifest.schema.json",
  "title": "scion.manifest.json",
  "description": "Generated by scion gen from the code: anchors, grafts, tunables, recipes and probes. Never edited by hand.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Format version of this file. Always 1 in Scion 1.x."
    },
    "scion": {
      "type": "string",
      "description": "Scion version."
    },
    "generated_from": {
      "type": "string",
      "description": "build_id or \"source\"."
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One anchor.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable anchor id ([Anchor] Id) or the slot id."
          },
          "target": {
            "type": "string",
            "description": "Type.Method."
          },
          "signature": {
            "type": "string",
            "description": "C# signature."
          },
          "doc": {
            "type": [
              "string",
              "null"
            ],
            "description": "One line."
          },
          "slot": {
            "type": "boolean",
            "description": "Has a slot in test builds."
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Grafts on it."
          }
        },
        "required": [
          "id",
          "target",
          "signature",
          "slot",
          "used_by"
        ],
        "additionalProperties": false
      },
      "description": "Anchors."
    },
    "grafts": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One graft.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Ns.Type.Method."
          },
          "file": {
            "type": "string",
            "description": "Source file."
          },
          "line": {
            "type": "integer",
            "description": "Line."
          },
          "kind": {
            "enum": [
              "before",
              "after"
            ]
          },
          "target": {
            "type": "string",
            "description": "Type.Method."
          },
          "priority": {
            "type": "integer",
            "description": "Priority."
          },
          "observe": {
            "type": "boolean",
            "description": "Observer."
          },
          "promoted": {
            "type": "boolean",
            "description": "In the promoted folder."
          }
        },
        "required": [
          "name",
          "file",
          "line",
          "kind",
          "target",
          "priority",
          "observe",
          "promoted"
        ],
        "additionalProperties": false
      },
      "description": "Grafts."
    },
    "tunables": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One tunable.",
        "properties": {
          "key": {
            "type": "string",
            "description": "Type.Member."
          },
          "type": {
            "type": "string",
            "description": "C# type."
          },
          "min": {
            "type": [
              "number",
              "null"
            ],
            "description": "Min."
          },
          "max": {
            "type": [
              "number",
              "null"
            ],
            "description": "Max."
          },
          "value": {},
          "layer": {
            "enum": [
              "visual",
              "rule"
            ]
          },
          "doc": {
            "type": [
              "string",
              "null"
            ],
            "description": "One line."
          }
        },
        "required": [
          "key",
          "type",
          "min",
          "max",
          "value",
          "layer"
        ],
        "additionalProperties": false
      },
      "description": "Tunables."
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One recipe.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Recipe name."
          },
          "type": {
            "type": "string",
            "description": "Class."
          },
          "players": {
            "type": "integer",
            "description": "Players."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "One line."
          }
        },
        "required": [
          "name",
          "type",
          "players",
          "tags"
        ],
        "additionalProperties": false
      },
      "description": "Recipes."
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One probe.",
        "properties": {
          "key": {
            "type": "string",
            "description": "Probe key."
          },
          "member": {
            "type": "string",
            "description": "Type.Member with [Probe]."
          }
        },
        "required": [
          "key",
          "member"
        ],
        "additionalProperties": false
      },
      "description": "Probes declared with [Probe]."
    }
  },
  "required": [
    "schema_version",
    "scion",
    "anchors",
    "grafts",
    "tunables",
    "recipes",
    "probes"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "schema_version": 1,
      "scion": "1.0.0",
      "generated_from": "source",
      "anchors": [
        {
          "id": "presentation.hit",
          "target": "Orchard.Presentation.HitPresenter.Play",
          "signature": "float Play(HitEvent e)",
          "doc": "Plays one hit and returns how long it lasts.",
          "slot": true,
          "used_by": [
            "Orchard.Grafts.HitFlash.After",
            "Orchard.Grafts.CritShake.After"
          ]
        }
      ],
      "grafts": [
        {
          "name": "Orchard.Grafts.HitFlash.After",
          "file": "Assets/Orchard/Grafts/HitFlash.cs",
          "line": 9,
          "kind": "after",
          "target": "Orchard.Presentation.HitPresenter.Play",
          "priority": 0,
          "observe": false,
          "promoted": true
        }
      ],
      "tunables": [
        {
          "key": "CritShake.Strength",
          "type": "float",
          "min": 0,
          "max": 1,
          "value": 0.3,
          "layer": "visual",
          "doc": "Camera shake on a critical hit."
        }
      ],
      "recipes": [
        {
          "name": "SlashHit",
          "type": "Orchard.Trials.SlashHit",
          "players": 1,
          "tags": [
            "combat"
          ],
          "description": "A knight slashes a goblin."
        }
      ],
      "probes": [
        {
          "key": "damage",
          "member": "Orchard.Presentation.HitPresenter.LastDamage"
        }
      ]
    }
  ]
}
